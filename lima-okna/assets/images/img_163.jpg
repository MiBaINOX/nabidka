Date();$('#qsearchtext').smartFocus('Hledat');});</script></head><body><div id="documentOverlay"></div><div id="flyer1"><p><a href="https://www.limaokna.cz/ke-stazeni/pro-partnery">Vstup pro partnery</a></p></div><div class="vse"><div id="headerimage"></div><div class="sirka"><div class="topbg"><div class="top" ><div class="topinner"><a class="logolink logolink1" href="https://www.limaokna.cz" title="Lima Okna"  role="banner"></a><div class="search" role="search"><form action="https://www.limaokna.cz/hledat" method="post" onsubmit="if ($('#qsearchtext').val()=='Hledat' || $('#qsearchtext').val().length < 3) {alert('Hledaný výraz je příliš krátký.');$('#qsearchtext').focus();return false;} $('#searchsubmit').attr('disabled',true);"><img src="https://www.limaokna.cz/images/ic/magnifier.png?ver=20241119" alt="magnifier"   class="ico" id="searchIco"> <input type="text" id="qsearchtext" name="qsearchtext" placeholder="Hledat" class="searchinput jtit4" maxlength="25"><input type="submit" name="search" id="qsearch" value=">" class="searchsubmit"></form></div><div id="menu" role="navigation"><ul id="mainMenu" style="text-align:left" role="menubar"><li><a href="https://www.limaokna.cz" class="menulink" id="menu1" role="menuitem">Úvod</a></li><li><a href="https://www.limaokna.cz/o-nas" class="menulink" id="menu2" role="menuitem">O nás</a></li><li><a href="https://www.limaokna.cz/plastova-okna" class="menulink menuArrow" id="menu3" role="menuitem">Plastová okna</a><ul><li><a href="https://www.limaokna.cz/plastova-okna/profily" role="menuitem">Profily</a></li><li><a href="https://www.limaokna.cz/plastova-okna/kovani-a-kliky" role="menuitem">Kování a kliky</a></li><li><a href="https://www.limaokna.cz/plastova-okna/typy-oken" role="menuitem">Typy oken</a></li><li><a href="https://www.limaokna.cz/plastova-okna/skla-a-meziskelni-mrizky" role="menuitem">Skla a meziskelní mřížky</a></li><li><a href="https://www.limaokna.cz/plastova-okna/barevna-provedeni" role="menuitem">Barevná provedení</a></li><li><a href="https://www.limaokna.cz/plastova-okna/technicka-knihovna-softline" role="menuitem">Technická knihovna Softline</a></li></ul></li><li><a href="https://www.limaokna.cz/plastove-dvere" class="menulink menuArrow" id="menu4" role="menuitem">Plastové dveře</a><ul><li><a href="https://www.limaokna.cz/plastove-dvere/profily-dveri" role="menuitem">Profily</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/typy-vstupnich-dveri" role="menuitem">Typy vstupních dveří</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/typy-balkonovych-dveri" role="menuitem">Typy balkonových dveří</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/zdvizne-posuvne-dvere-hst" role="menuitem">Zdvižně posuvné dveře HST</a></li><li><a href="https://www.limaokna.cz/dverni-vyplne" role="menuitem">Dveřní výplně</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/kovani-a-kliky-dveri" role="menuitem">Kování a kliky</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/skla-vitraze-a-mrizky" role="menuitem">Skla, vitráže a mřížky</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/skla-a-meziskelni-mrizky-dveri" role="menuitem">Skla a meziskelní mřížky</a></li><li><a href="https://www.limaokna.cz/plastove-dvere/doplnky-vstupnich-dveri" role="menuitem">Doplňky vstupních dveří</a></li></ul></li><li><a href="https://www.limaokna.cz/aluconnect" class="menulink" id="menu5" role="menuitem">AluConnect</a></li><li><a href="https://www.limaokna.cz/materialy" class="menulink" id="menu6" role="menuitem">Materiály</a></li><li><a href="https://www.limaokna.cz/kontakty" class="menulink" id="menu7" role="menuitem">Kontakty</a></li></ul></div></div></div></div><div class="column" style="padding-bottom:1px;" role="main"><div id="nav"><a href="https://www.limaokna.cz">Úvod</a> > Aktuality</div><div class="contentpadding"><h1>Aktuality</h1><div class=" editableElementnews1" rel="9"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/9_2.jpg" alt="images/big/aktuality/0/9_2.jpg" style="width:100px;"></span><h3>Designové skleněné výplně</h3><span class="info">5. květen 2026, 11:12</span><p>Rozšířili jsme nabídku o Designové skleněné výplně, které svým jedinečným individuálním vzhledem dají Vašemu domu moderní exklusivní vzhled. </p><a href="https://www.limaokna.cz/dverni-vyplne/designove-sklenene-vyplne" class="moreLink">více</a><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="8"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/8_2.jpg?v=1" alt="images/big/aktuality/0/8_2.jpg?v=1" style="width:100px;"></span><h3>Bezpečnostní lepená skla</h3><span class="info">4. říjen 2024, 08:14</span><p>Připravili jsme pro Vás video ukázku klasické destrukce lepeného skla. Lepené skla sice nejsou žádnou novinkou, ale jejich použití v ČR je minimální, byť v okolních zemích jako je Rakousko, Německo, Itálie kde se mimo jiné řeší bezpečnost uživatele i zábradelní funkce skleněných výplní je jejich použití několikanásobně vyšší ČR. Jejich použití není finančně ani technicky náročné a rozhodně ho svým zákazníkům v kombinaci s našim bezpečnostním kováním, které máme ve standardu doporučujeme.</p><a href="https://www.youtube.com/watch?v=a-Ftv3QvwA8" class="moreLink">více</a><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="7"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/7_2.jpg?v=1" alt="images/big/aktuality/0/7_2.jpg?v=1" style="width:100px;"></span><h3>LIMA okna představuje</h3><span class="info">4. leden 2024, 09:37</span><p>Naše společnost LIMA okna s.r.o. v úzké spolupráci s předním výrobcem PVC profilů společností VEKA a dodavateli strojního vybavení představuje novinku "skrytý svár". Tato technologie pod obchodním názvem ContourLine umožňuje svařovaní profilů takovým způsobem , že čelní pohledovou plochu okenních konstrukcí v barevných imitacích již není nutné zapravovat retušovací tužkou, jak bylo do dnešních dnů nezbytně nutné. Takový detail sváru přináší nemalou "přidanou hodnotu" k vizuální stránce okna, která se dnes stává zásadním kriteriem, při výběru nových oken a dveří.</p><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="6"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/6_2.jpg" alt="images/big/aktuality/0/6_2.jpg" style="width:100px;"></span><h3>Strukturální rohové zasklení</h3><span class="info">7. duben 2021, 12:15</span><p>Strukturální rohové zasklení umožňuje ničím nerušený výhled. Rohový spoj není tvořen PVC rámy, nýbrž pouze skly vsazenými do sebe. I taková skla lze osadit vnitřní integrovanou žaluzií.</p><a href="https://www.limaokna.cz/ke-stazeni/viewer/80" class="moreLink">více</a><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="5"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/5_2.jpg?v=1" alt="images/big/aktuality/0/5_2.jpg?v=1" style="width:100px;"></span><h3>Nové barvy pro rok 2021</h3><span class="info">11. březen 2021, 09:14</span><p>Pro rok 2021 jsme pro Vás mimo jiné připravili tyto dva nové dřevodekory. Sheffield oak light a Sheffield oak grey. </p>
<p> </p><a href="https://www.limaokna.cz/ke-stazeni/viewer/77" class="moreLink">více</a><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="4"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="https://www.limaokna.cz/images/big/aktuality/0/4_2.jpg?v=1" alt="images/big/aktuality/0/4_2.jpg?v=1" style="width:100px;"></span><h3>Barvy pro rok 2020</h3><span class="info">23. září 2020, 09:17</span><p>Pro rok 2020 jsme připravili rozšířenou nabídku barev. Přes 50 vzorů imitačních folií. Od imitací dřeva až po folie v metalickém designu imitací hliníku. </p><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="3"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="" alt="" style="width:100px;"></span><h3>LIMA okna -nový web</h3><span class="info">7. září 2020, 13:27</span><p>Právě jsme spustili naše nové webové stránky, které dostaly nový svěží moderní design.Věříme, že se Vám budou líbit a že zde naleznete maximum informací, které Vás zaujmou a pomohou Vám nalézt produkty a informace, které hledáte.</p><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="2"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/2_2.jpg" alt="images/big/aktuality/0/2_2.jpg" style="width:100px;"></span><h3>Nabízíme zdvižně posuvné dveře</h3><span class="info">1. březen 2014, 11:16</span><p>Zdvižně posuvné dveře je výrobek umožňující výrobu posuvného velkoformátové křidla. Nízký bezbariérový hliníkový práh,nerušený výhled, lehká manipulace s křídlem, skvělá izolace - trojskla, bohatá nabídka barev a imitací dřeva.</p><p class="bbottom newsBottom"></p></div><div class=" editableElementnews1" rel="1"><span class="gi2" style="border:0;float:right;margin:0 0 0 5px;"><img src="images/big/aktuality/0/1_2.jpg?v=1" alt="images/big/aktuality/0/1_2.jpg?v=1" style="width:100px;"></span><h3>Zahájili jsme výrobu z nového profilu</h3><span class="info">12. leden 2013, 11:14</span><p>Jako první výrobce v ČR jsme zahájili výrobu z nového německého profilu VEKA Softline 82. Jedná se o nový profil předního výrobce okenních profilů firmy VEKA.</p><p class="bbottom newsBottom"></p></div><div style="clear:both"></div></div></div></div><div class="bottom3"><div class="bottom"><div class="bottom2" role="contentinfo"><span style="float:right;" id="ccCopy"><a href="http://webdesign.skrabalek.cz/redakcni-system" class="bottomlink" title="Tento web využívá redakční systém CalmCube2">CalmCube2 CMS</a> · <a href="http://webdesign.skrabalek.cz" class="bottomlink" title="Webdesign, tvorba www stránek">Webdesign Michal Škrabálek</a></span><form method="post" action="" id="delpass" name="delpass"><input type="hidden" name="deletesession" value="1"></form><form method="post" action="" id="printpage" name="printpage"><input type="hidden" name="printit" value="1"></form><form method="post" action="" id="mobile" name="mobile"><input type="hidden" name="setmobile" value="1"></form><a href="https://www.limaokna.cz/rss" class="bottomlink" style="margin-right:5px;"><img src="images/ic/feed.png?ver=20241119" alt="RSS"  title="RSS" class="ico" ></a><a href="javascript:printpage.submit()" rel="nofollow" class="bottomlink" style="margin-right:5px;"><img src="images/ic/print.png?ver=20241119" alt="Vytisknout stránku"  title="Vytisknout stránku" class="ico" ></a><a href="https://www.limaokna.cz/ke-stazeni/pro-partnery" style="margin-right:10px">Vstup pro partnery</a>· <a href="https://www.limaokna.cz/mapa-stranek" class="bottomlink" style="margin-right:5px;">Mapa stránek</a>· <a href="javascript:mobile.submit();" rel="nofollow" class="bottomlink" title="DESKTOP browser detected">Mobilní verze</a> · © 2020 - 2026 Lima Okna</div></div></div></div><div id="dialog"><div id="dialogHeader"></div><div id="dialogContent"></div><div id="dialogButtons"><input type="button" class="submit2 none" id="dialogSave" value="" rel=""> <input type="button" class="submit3 closedialog" id="dialogStorno" value="Zrušit"></div></div></body></html>